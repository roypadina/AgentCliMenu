{
  "description": "acm-sessions: hand each session its Agent CLI Menu name, note, flags and due reminders at startup.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "acm hook session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
